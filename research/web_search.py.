import re
import requests
from bs4 import BeautifulSoup
from urllib.parse import quote, urlparse


class WebSearch:

    def __init__(self):

        self.headers = {
            "User-Agent": (
                "Mozilla/5.0 (Linux; Android 10; "
                "K) AppleWebKit/537.36 "
                "(KHTML, like Gecko) "
                "Chrome/120.0 Mobile Safari/537.36"
            )
        }

        self.timeout = 15


    # =================================
    # CLEAN TEXT
    # =================================

    def clean_text(self, text):

        if not text:
            return ""

        text = re.sub(
            r"\s+",
            " ",
            str(text)
        )

        return text.strip()


    # =================================
    # GET DOMAIN
    # =================================

    def get_domain(self, url):

        try:

            domain = urlparse(
                url
            ).netloc.lower()

            if domain.startswith("www."):
                domain = domain[4:]

            return domain

        except Exception:

            return ""


    # =================================
    # SEARCH DUCKDUCKGO
    # =================================

    def search_duckduckgo(
        self,
        query,
        max_results=8
    ):

        results = []

        try:

            url = (
                "https://html.duckduckgo.com/html/?q="
                + quote(query)
            )

            response = requests.get(
                url,
                headers=self.headers,
                timeout=self.timeout
            )

            if response.status_code != 200:

                return []

            soup = BeautifulSoup(
                response.text,
                "html.parser"
            )

            items = soup.select(
                ".result"
            )

            for item in items:

                if len(results) >= max_results:
                    break

                title_tag = item.select_one(
                    ".result__title"
                )

                link_tag = item.select_one(
                    ".result__a"
                )

                snippet_tag = item.select_one(
                    ".result__snippet"
                )

                if not link_tag:
                    continue

                title = self.clean_text(
                    link_tag.get_text(
                        " ",
                        strip=True
                    )
                )

                href = link_tag.get(
                    "href",
                    ""
                )

                snippet = ""

                if snippet_tag:

                    snippet = self.clean_text(
                        snippet_tag.get_text(
                            " ",
                            strip=True
                        )
                    )

                if not href:
                    continue

                domain = self.get_domain(
                    href
                )

                results.append({

                    "title": title,

                    "url": href,

                    "snippet": snippet,

                    "source": domain,

                    "content": "",

                    "date": ""

                })

        except Exception as error:

            print(
                "[DuckDuckGo error:",
                error,
                "]"
            )

        return results


    # =================================
    # FETCH PAGE
    # =================================

    def fetch_page(
        self,
        url
    ):

        try:

            response = requests.get(
                url,
                headers=self.headers,
                timeout=self.timeout
            )

            if response.status_code != 200:

                return ""

            soup = BeautifulSoup(
                response.text,
                "html.parser"
            )


            # Remove unwanted elements

            for tag in soup(
                [
                    "script",
                    "style",
                    "noscript",
                    "svg",
                    "nav",
                    "footer",
                    "header",
                    "form",
                    "aside"
                ]
            ):

                tag.decompose()


            text = soup.get_text(
                " ",
                strip=True
            )

            text = self.clean_text(
                text
            )


            # Avoid useless pages

            if len(text) < 300:

                return ""


            # Keep reasonable amount

            return text[:12000]


        except Exception:

            return ""


    # =================================
    # EXTRACT DATE
    # =================================

    def extract_date(
        self,
        text
    ):

        if not text:
            return ""

        patterns = [

            r"\b20\d{2}-\d{1,2}-\d{1,2}\b",

            r"\b\d{1,2}/\d{1,2}/20\d{2}\b",

            r"\b(?:January|February|March|April|May|June|"
            r"July|August|September|October|November|December)"
            r"\s+\d{1,2},\s+20\d{2}\b",

            r"\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|"
            r"Oct|Nov|Dec)\.?\s+\d{1,2},\s+20\d{2}\b",

            r"\b\d{1,2}\s+(?:January|February|March|April|"
            r"May|June|July|August|September|October|"
            r"November|December)\s+20\d{2}\b"

        ]


        for pattern in patterns:

            match = re.search(
                pattern,
                text,
                re.IGNORECASE
            )

            if match:

                return match.group(
                    0
                )

        return ""


    # =================================
    # FETCH RESULT CONTENT
    # =================================

    def enrich_result(
        self,
        result
    ):

        url = result.get(
            "url",
            ""
        )

        print(
            "Reading:",
            result.get(
                "title",
                ""
            )
        )

        content = self.fetch_page(
            url
        )


        if not content:

            print(
                "Skipped: no page content"
            )

            return None


        date = self.extract_date(
            content
        )


        result["content"] = content

        result["date"] = date

        result["source"] = (
            result.get(
                "source",
                ""
            )
            or self.get_domain(url)
        )


        return result


    # =================================
    # REMOVE DUPLICATES
    # =================================

    def remove_duplicates(
        self,
        results
    ):

        output = []

        seen_urls = set()

        seen_titles = set()


        for result in results:

            url = result.get(
                "url",
                ""
            ).strip().lower()

            title = self.clean_text(
                result.get(
                    "title",
                    ""
                )
            ).lower()


            if url and url in seen_urls:
                continue

            if title and title in seen_titles:
                continue


            if url:
                seen_urls.add(
                    url
                )

            if title:
                seen_titles.add(
                    title
                )

            output.append(
                result
            )


        return output


    # =================================
    # RESEARCH
    # =================================

    def research(
        self,
        query,
        max_results=5
    ):

        raw_results = (
            self.search_duckduckgo(
                query,
                max_results=max_results + 3
            )
        )


        if not raw_results:

            return []


        raw_results = (
            self.remove_duplicates(
                raw_results
            )
        )


        final_results = []


        for result in raw_results:

            if len(final_results) >= max_results:
                break


            enriched = (
                self.enrich_result(
                    result
                )
            )


            if enriched:

                final_results.append(
                    enriched
                )


        return final_results


    # =================================
    # SIMPLE SEARCH
    # =================================

    def search(
        self,
        query,
        max_results=5
    ):

        return self.research(
            query,
            max_results
        )